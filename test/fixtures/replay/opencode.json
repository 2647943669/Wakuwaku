    { "at": 6000, "event": { "type": "session.tool.called", "sessionID": "replay-oc", "directory": "Z:\\replay\\oc", "id": "call_2", "tool": "edit", "input": { "path": "Z:\\replay\\oc\\src\\a.rs", "oldString": "a", "newString": "b" } } },

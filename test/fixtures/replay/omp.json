{
  "about": "oh-my-pi through her extension: tools in lower case with their intent, an edit bringing its file, an approval asked in omp's own window and resolved, a plan review on her, the end a review; a failure; a turn interrupted; the session's end.",
  "agent": "omp",
  "steps": [
    { "at": 1000, "event": { "session_id": "replay-omp", "cwd": "Z:\\replay\\omp", "hook_event_name": "SessionStart", "source": "startup" } },

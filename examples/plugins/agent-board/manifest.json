{
  "id": "agent-board",
  "kind": "plugin",
  "name": { "en": "Agent board", "zh": "Agent 排行" },
  "description": { "en": "Which project kept your agents busiest today", "zh": "今天哪个项目让 agent 干得最多" },
  "version": "1.0.0",
  "author": "wakuwaku",
  "api": 1,
  "main": "main.js",
  "view": "view.html",
  "category": "productivity",
  "widget": {
    "sizes": ["s", "m", "l"],
    "color": "#f5a35c",
    "icon": "chart",
    "sample": {
      "label": "pet",
      "value": "96 min",
      "detail": {
        "series": { "points": [96, 58, 41, 16], "unit": "min" },
        "rows": [
          { "name": "pet", "value": "96 min" },
          { "name": "agent-hub", "value": "58 min" },
          { "name": "md-editor", "value": "41 min" },
          { "name": "dotfiles", "value": "16 min" }
        ],
        "extra": "4 · 211 min"
      }
    }
  },
  "permissions": { "agents": true }
}
